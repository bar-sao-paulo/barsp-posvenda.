{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "gunicorn 'posvenda.web:criar_app()' --bind 0.0.0.0:$PORT --workers 1 --threads 4 --timeout 120",
    "healthcheckPath": "/saude",
    "restartPolicyType": "ON_FAILURE"
  }
}
